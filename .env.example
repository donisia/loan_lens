ANTHROPIC_API_KEY=

# Africa's Talking (SMS + USSD): https://account.africastalking.com -> Sandbox -> Settings -> API Key
# Use the username "sandbox" while testing.
AT_USERNAME=sandbox
AT_API_KEY=

